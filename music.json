  function hex(n) {
    var s = "";
    for (var k = 0; k < 4; k++) s += ("0" + ((n >> (k * 8)) & 0xff).toString(16)).slice(-2);
    return s;
  }
  return hex(a) + hex(b) + hex(c) + hex(d);
}

async function wbiSign(params) {
  var mixin = await getWbiKeys();
  var p = {};
  for (var k in params) { if (Object.prototype.hasOwnProperty.call(params, k)) p[k] = params[k]; }
  p.wts = Math.floor(Date.now() / 1000);
  var keys = [];
  for (var kk in p) { if (Object.prototype.hasOwnProperty.call(p, kk)) keys.push(kk); }
  keys.sort();
  var qs = [];
  for (var i = 0; i < keys.length; i++) {
    qs.push(keys[i] + "=" + encodeURIComponent(p[keys[i]]));
  }
  p.w_rid = md5(qs.join("&") + mixin);
  return p;
}

/* ---------- 工具 ---------- */
function cleanTitle(s) {
  if (!s) return "";
  return String(s)
    .replace(/<[^>]+>/g, "")
    .replace(/&quot;/g, '"')
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&#39;/g, "'")
    .trim();
}

function pic(url) {
  if (!url) return "";
  if (String(url).indexOf("//") === 0) return "https:" + url;
  return String(url);
}

function norm(items) {
  var out = [];
  var arr = items || [];
  for (var i = 0; i < arr.length; i++) {
    var it = arr[i];
    if (!it || !it.bvid) continue;
    out.push({
      vod_id: it.bvid,
      vod_name: cleanTitle(it.title || ""),
      vod_pic: pic(it.pic || ""),
      vod_remarks: it.duration || "",
      vod_actor: it.author || "",
      vod_content: it.description || ""
    });
  }
  return out;
}

/* ---------- 业务 ---------- */
async function searchOnce(endpoint, keyword, pg, order, duration, signed) {
  try {
    if (String(endpoint).indexOf("search/all/v2") >= 0) {
      var r0 = await httpJson(endpoint, { keyword: keyword, page: pg });
      if (!r0 || r0.code !== 0) return { list: [], pages: 1 };
      var blocks = (r0.data && r0.data.result) || [];
      var vids = [];
      for (var i = 0; i < blocks.length; i++) {
        if (blocks[i] && blocks[i].result_type === "video") {
          vids = blocks[i].data || [];
          break;
        }
      }
      return { list: norm(vids), pages: parseInt((r0.data && r0.data.numPages) || 1, 10) };
    }
    var params = { search_type: "video", keyword: keyword, page: pg, page_size: 20 };
    if (order && order !== "0") {
      var map = { "0": "totalrank", click: "click", pubdate: "pubdate", dm: "dm", stow: "stow" };
      params.order = map[order] || "totalrank";
    }
    if (duration && duration !== "0") params.duration = duration;
    if (signed) params = await wbiSign(params);
    var r = await httpJson(endpoint, params);
    if (!r || r.code !== 0) return { list: [], pages: 1 };
    return {
      list: norm((r.data && r.data.result) || []),
      pages: parseInt((r.data && r.data.numPages) || 1, 10)
    };
  } catch (e) {
    return { list: [], pages: 1 };
  }
}

async function biliSearch(keyword, pg, order, duration) {
  var eps = [
    ["https://api.bilibili.com/x/web-interface/search/type", true],
    ["https://api.bilibili.com/x/web-interface/search/all/v2", false],
    ["https://api.bilibili.com/x/web-interface/search/type", false]
  ];
  for (var rnd = 0; rnd < 2; rnd++) {
    for (var i = 0; i < eps.length; i++) {
      var res = await searchOnce(eps[i][0], keyword, pg, order, duration, eps[i][1]);
      if (res.list && res.list.length) return res;
    }
  }
  return { list: [], pages: 1 };
}

async function ranking() {
  var rids = ["3", "1", "4"];
  for (var i = 0; i < rids.length; i++) {
    var r = await httpJson("https://api.bilibili.com/x/web-interface/ranking/v2", { rid: rids[i], type: "all" });
    if (r && r.code === 0) {
      var lst = (r.data && r.data.list) || [];
      if (lst.length) {
        var out = [];
        for (var j = 0; j < lst.length; j++) {
          var it = lst[j];
          if (!it.bvid) continue;
          out.push({
            vod_id: it.bvid,
            vod_name: cleanTitle(it.title || ""),
            vod_pic: pic(it.pic || ""),
            vod_remarks: "热门",
            vod_actor: (it.owner && it.owner.name) || "",
            vod_content: it.desc || ""
          });
        }
        if (out.length) return out;
      }
    }
  }
  return [];
}

async function view(bvid, p) {
  var r = await httpJson("https://api.bilibili.com/x/web-interface/view", { bvid: bvid });
  if (r && r.code === 0 && r.data) return r.data;
  var r2 = await httpJson("https://api.bilibili.com/x/player/pagelist", { bvid: bvid });
  if (r2 && r2.code === 0 && r2.data) {
    var pages = r2.data;
    var idx = Math.min(Math.max((p || 1) - 1, 0), pages.length - 1);
    return {
      bvid: bvid,
      cid: pages[idx].cid || 0,
      pages: pages,
      title: pages[idx].part || "",
      pic: "",
      stat: {}
    };
  }
  return {};
}

async function playurl(bvid, cid) {
  var qns = SESSDATA ? [80, 64, 32, 16] : [64, 32, 16];
  var endpoints = [
    ["https://api.bilibili.com/x/player/wbi/playurl", true],
    ["https://api.bilibili.com/x/player/playurl", false]
  ];
  for (var qi = 0; qi < qns.length; qi++) {
    var qn = qns[qi];
    for (var ei = 0; ei < endpoints.length; ei++) {
      for (var fi = 0; fi < 2; fi++) {
        var params = {
          bvid: bvid,
          cid: cid,
          qn: qn,
          fnval: fi === 0 ? 1 : 0,
          fnver: 0,
          fourk: 1,
          platform: "pc"
        };
        if (endpoints[ei][1]) params = await wbiSign(params);
        var r = await httpJson(endpoints[ei][0], params);
        if (!r || r.code !== 0) continue;
        var data = r.data || {};
        var durl = data.durl || [];
        if (durl.length && durl[0].url) return { url: durl[0].url, qn: qn };
        var dash = data.dash || {};
        var videos = dash.video || [];
        if (videos.length) {
          videos.sort(function (a, b) { return (b.id || 0) - (a.id || 0); });
          var base = videos[0].baseUrl || videos[0].base_url || "";
          if (base) return { url: base, qn: qn };
        }
      }
    }
  }
  return { url: "", qn: 0 };
}

function asObj(v) {
  if (v && typeof v === "object") return v;
  if (typeof v === "string") {
    var s = v.trim();
    if (!s) return null;
    try { return JSON.parse(s); } catch (e) { return null; }
  }
  return null;
}

/* ---------- 生命周期（Tank 版反射调用，必须是全局函数） ---------- */
function init(ext) {
  try {
    var obj = asObj(ext) || {};
    var ck = obj.cookies || obj.cookie || "";
    var m = String(ck).match(/SESSDATA=([^;]+)/);
    if (m) SESSDATA = m[1].trim();
    if (obj.sessdata) SESSDATA = String(obj.sessdata).trim();
  } catch (e) {}
}

function home(filter) {
  var result = { class: CLASSES, list: [] };
  if (filter) result.filters = FILTERS;
  return JSON.stringify(result);
}

async function homeVod() {
  try {
    return JSON.stringify({ list: await ranking() });
  } catch (e) {
    return JSON.stringify({ list: [] });
  }
}

async function category(tid, pg, filter, extend) {
  try {
    pg = String(pg || "1");
    var ext = asObj(extend) || {};
    var keyword = String(ext.tid || tid || "").trim();
    var order = String(ext.order || "0");
    var duration = String(ext.duration || "0");
    var res = await biliSearch(keyword, pg, order, duration);
    if ((!res.list || !res.list.length) && (pg === "1" || pg === 1)) {
      var alts = [keyword + "超清", keyword.replace("超清", "").trim(), keyword + " MV"];
      for (var i = 0; i < alts.length; i++) {
        if (!alts[i] || alts[i] === keyword) continue;
        res = await biliSearch(alts[i], pg, order, duration);
        if (res.list && res.list.length) break;
      }
    }
    if ((!res.list || !res.list.length) && (pg === "1" || pg === 1)) {
      res = { list: await ranking(), pages: 1 };
    }
    return JSON.stringify({
      list: res.list || [],
      page: pg,
      pagecount: Math.max(res.pages || 1, 1),
      limit: 20,
      total: (res.list || []).length
    });
  } catch (e) {
    return JSON.stringify({ list: [], page: "1", pagecount: 1, limit: 20, total: 0 });
  }
}

async function detail(ids) {
  try {
    var vid = "";
    if (Object.prototype.toString.call(ids) === "[object Array]") vid = String(ids[0] || "");
    else if (ids && typeof ids === "object") vid = String(ids.id || ids.vod_id || "");
    else vid = String(ids || "");
    vid = vid.replace(/^["']|["']$/g, "").trim();
    var bvid = vid.split("?")[0].split("$")[0].trim();
    if (!bvid) return JSON.stringify({ list: [] });
    var info = await view(bvid, 1);
    var pages = info.pages || [];
    var play = "";
    if (pages.length <= 1) {
      play = "正片$" + bvid;
    } else {
      var eps = [];
      for (var i = 0; i < pages.length; i++) {
        var name = String(pages[i].part || "").trim() || "第" + (i + 1) + "集";
        eps.push(name + "$" + bvid + "?p=" + (i + 1));
      }
      play = eps.join("#");
    }
    var stat = info.stat || {};
    var remark = "";
    if (stat.view != null) {
      var v = parseInt(stat.view, 10) || 0;
      var d = parseInt(stat.danmaku, 10) || 0;
      var fv = v >= 100000000 ? (v / 100000000).toFixed(1) + "亿" : v >= 10000 ? (v / 10000).toFixed(1) + "万" : String(v);
      var fd = d >= 10000 ? (d / 10000).toFixed(1) + "万" : String(d);
      remark = "播放:" + fv + " 弹幕:" + fd;
    }
    var year = "";
    try { if (info.pubdate) year = String(new Date(info.pubdate * 1000).getFullYear()); } catch (e) {}
    var vod = {
      vod_id: bvid,
      vod_name: info.title || bvid,
      vod_pic: pic(info.pic || ""),
      type_name: "音乐/演唱会",
      vod_year: year,
      vod_area: "哔哩哔哩",
      vod_remarks: remark,
      vod_actor: (info.owner && info.owner.name) || "",
      vod_director: "",
      vod_content: info.desc || "",
      vod_play_from: "哔哩哔哩$$$" + "演唱会",
      vod_play_url: play
    };
    return JSON.stringify({ list: [vod] });
  } catch (e) {
    return JSON.stringify({ list: [] });
  }
}

async function search(key, quick, pg) {
  try {
    pg = String(pg || "1");
    var res = await biliSearch(String(key || "").trim(), pg, "totalrank", "0");
    return JSON.stringify({
      list: res.list || [],
      page: pg,
      pagecount: Math.max(res.pages || 1, 1)
    });
  } catch (e) {
    return JSON.stringify({ list: [], page: "1", pagecount: 1 });
  }
}

async function play(flag, id, vipFlags) {
  var header = {
    "User-Agent": UA,
    Referer: "https://www.bilibili.com",
    Origin: "https://www.bilibili.com",
    Accept: "*/*",
    "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8"
  };
  if (SESSDATA) header.Cookie = "SESSDATA=" + SESSDATA;

  var bvid = "";
  var p = 1;
  var cand = String(id || "");
  var m = cand.match(/(BV[0-9A-Za-z]{8,})/);
  if (m) {
    bvid = m[1];
    var mp = cand.match(/[?&]p=(\d+)/);
    if (mp) p = parseInt(mp[1], 10);
  }
  if (!bvid) return JSON.stringify({ parse: 0, url: "", header: header });

  try {
    var info = await view(bvid, p);
    var cid = info.cid || 0;
    var pages = info.pages || [];
    if (!cid && pages.length) {
      var idx = Math.min(Math.max(p - 1, 0), pages.length - 1);
      cid = pages[idx].cid || 0;
    }
    if (cid) {
      var pu = await playurl(bvid, cid);
      if (pu.url) {
        return JSON.stringify({ parse: 0, url: pu.url, header: header });
      }
    }
  } catch (e) {}
  return JSON.stringify({ parse: 0, url: "", header: header });
}

/* ---------- 别名（部分 TVBox 内核按 *Content 命名反射） ---------- */
function homeContent(filter) { return home(filter); }
function homeVideoContent() { return homeVod(); }
function categoryContent(tid, pg, filter, extend) { return category(tid, pg, filter, extend); }
function detailContent(ids) { return detail(ids); }
function searchContent(key, quick, pg) { return search(key, quick, pg); }
function playerContent(flag, id, vipFlags) { return play(flag, id, vipFlags); }
