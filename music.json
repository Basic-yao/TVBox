  function hex(n) {
    let s = "";
    for (let j = 0; j < 4; j++) s += ("0" + ((n >> (j * 8)) & 0xff).toString(16)).slice(-2);
    return s;
  }
  return hex(a) + hex(b) + hex(c) + hex(d);
}

function wbiSign(params) {
  const mixin = getWbiKeys();
  if (!mixin) return params;
  const p = Object.assign({}, params);
  p.wts = Math.floor(Date.now() / 1000);
  const keys = Object.keys(p).sort();
  const q = keys.map((k) => k + "=" + encodeURIComponent(p[k])).join("&");
  p.w_rid = md5(q + mixin);
  return p;
}

function cleanTitle(s) {
  if (!s) return "";
  return String(s)
    .replace(/<[^>]+>/g, "")
    .replace(/&quot;/g, '"')
    .replace(/&amp;/g, "&")
    .replace(/&lt;/g, "<")
    .replace(/&gt;/g, ">")
    .replace(/&#39;/g, "'")
    .trim();
}

function pic(url) {
  if (!url) return "";
  if (url.indexOf("//") === 0) return "https:" + url;
  return url;
}

function norm(items) {
  const out = [];
  (items || []).forEach((it) => {
    if (!it || !it.bvid) return;
    out.push({
      vod_id: it.bvid,
      vod_name: cleanTitle(it.title || ""),
      vod_pic: pic(it.pic || ""),
      vod_remarks: it.duration || "",
      vod_actor: it.author || "",
      vod_content: it.description || ""
    });
  });
  return out;
}

function searchOnce(endpoint, keyword, pg, order, duration, signed) {
  try {
    if (endpoint.indexOf("search/all/v2") >= 0) {
      const r = httpJson(endpoint, { keyword: keyword, page: pg });
      if (!r || r.code !== 0) return { list: [], pages: 1 };
      const blocks = (r.data && r.data.result) || [];
      let vids = [];
      for (let i = 0; i < blocks.length; i++) {
        if (blocks[i] && blocks[i].result_type === "video") {
          vids = blocks[i].data || [];
          break;
        }
      }
      return { list: norm(vids), pages: parseInt((r.data && r.data.numPages) || 1, 10) };
    }
    const params = {
      search_type: "video",
      keyword: keyword,
      page: pg,
      page_size: 20
    };
    if (order && order !== "0") {
      const map = { "0": "totalrank", click: "click", pubdate: "pubdate", dm: "dm", stow: "stow" };
      params.order = map[order] || "totalrank";
    }
    if (duration && duration !== "0") params.duration = duration;
    const p = signed ? wbiSign(params) : params;
    const r = httpJson(endpoint, p);
    if (!r || r.code !== 0) return { list: [], pages: 1 };
    return {
      list: norm((r.data && r.data.result) || []),
      pages: parseInt((r.data && r.data.numPages) || 1, 10)
    };
  } catch (e) {
    return { list: [], pages: 1 };
  }
}

function biliSearch(keyword, pg, order, duration) {
  const eps = [
    ["https://api.bilibili.com/x/web-interface/search/type", true],
    ["https://api.bilibili.com/x/web-interface/search/all/v2", false],
    ["https://api.bilibili.com/x/web-interface/search/type", false]
  ];
  for (let rnd = 0; rnd < 2; rnd++) {
    for (let i = 0; i < eps.length; i++) {
      const res = searchOnce(eps[i][0], keyword, pg, order, duration, eps[i][1]);
      if (res.list && res.list.length) return res;
    }
  }
  return { list: [], pages: 1 };
}

function ranking() {
  const rids = ["3", "1", "4"];
  for (let i = 0; i < rids.length; i++) {
    const r = httpJson("https://api.bilibili.com/x/web-interface/ranking/v2", {
      rid: rids[i],
      type: "all"
    });
    if (r && r.code === 0) {
      const lst = (r.data && r.data.list) || [];
      if (lst.length) {
        return lst
          .filter((it) => it.bvid)
          .map((it) => ({
            vod_id: it.bvid,
            vod_name: cleanTitle(it.title || ""),
            vod_pic: pic(it.pic || ""),
            vod_remarks: "热门",
            vod_actor: (it.owner && it.owner.name) || "",
            vod_content: it.desc || ""
          }));
      }
    }
  }
  return [];
}

function view(bvid, p) {
  const params = { bvid: bvid };
  if (p && p > 1) params.p = p;
  let r = httpJson("https://api.bilibili.com/x/web-interface/view", params);
  if (r && r.code === 0 && r.data) return r.data;
  r = httpJson("https://api.bilibili.com/x/player/pagelist", { bvid: bvid });
  if (r && r.code === 0 && r.data) {
    const pages = r.data;
    const idx = Math.min(Math.max((p || 1) - 1, 0), pages.length - 1);
    return {
      bvid: bvid,
      cid: pages[idx].cid || 0,
      pages: pages,
      title: pages[idx].part || "",
      pic: ""
    };
  }
  return {};
}

function playurl(bvid, cid) {
  const qns = SESSDATA ? [80, 64, 32, 16] : [64, 32, 16];
  const endpoints = [
    ["https://api.bilibili.com/x/player/wbi/playurl", true],
    ["https://api.bilibili.com/x/player/playurl", false]
  ];
  for (let qi = 0; qi < qns.length; qi++) {
    const qn = qns[qi];
    for (let ei = 0; ei < endpoints.length; ei++) {
      for (let fi = 0; fi < 2; fi++) {
        const fnval = fi === 0 ? 1 : 0;
        let params = {
          bvid: bvid,
          cid: cid,
          qn: qn,
          fnval: fnval,
          fnver: 0,
          fourk: 1,
          platform: "pc"
        };
        if (endpoints[ei][1]) params = wbiSign(params);
        const r = httpJson(endpoints[ei][0], params);
        if (!r || r.code !== 0) continue;
        const data = r.data || {};
        const durl = data.durl || [];
        if (durl.length && durl[0].url) return { url: durl[0].url, qn: qn };
        const dash = data.dash || {};
        const videos = dash.video || [];
        if (videos.length) {
          videos.sort((a, b) => (b.id || 0) - (a.id || 0));
          const base = videos[0].baseUrl || videos[0].base_url || "";
          if (base) return { url: base, qn: qn };
        }
      }
    }
  }
  return { url: "", qn: 0 };
}

function asObj(v) {
  if (v && typeof v === "object") return v;
  if (typeof v === "string") {
    const s = v.trim();
    if (!s) return null;
    try {
      return JSON.parse(s);
    } catch (e) {
      return null;
    }
  }
  return null;
}

function init(ext) {
  try {
    const obj = asObj(ext) || {};
    const ck = obj.cookies || obj.cookie || "";
    const m = String(ck).match(/SESSDATA=([^;]+)/);
    if (m) SESSDATA = m[1].trim();
    if (obj.sessdata) SESSDATA = String(obj.sessdata).trim();
  } catch (e) {}
}

function home(filter) {
  const result = { class: CLASSES, list: [] };
  if (filter) result.filters = FILTERS;
  return JSON.stringify(result);
}

function homeVod() {
  try {
    return JSON.stringify({ list: ranking() });
  } catch (e) {
    return JSON.stringify({ list: [] });
  }
}

function category(tid, pg, filter, extend) {
  try {
    pg = String(pg || "1");
    let ext = asObj(extend) || {};
    if (typeof extend === "string") {
      try {
        ext = JSON.parse(extend) || {};
      } catch (e) {}
    }
    let keyword = String(ext.tid || tid || "").trim();
    const order = String(ext.order || "0");
    const duration = String(ext.duration || "0");
    let res = biliSearch(keyword, pg, order, duration);
    if ((!res.list || !res.list.length) && (pg === "1" || pg === 1)) {
      const alts = [keyword + "超清", keyword.replace("超清", "").trim(), keyword + " MV"];
      for (let i = 0; i < alts.length; i++) {
        if (!alts[i] || alts[i] === keyword) continue;
        res = biliSearch(alts[i], pg, order, duration);
        if (res.list && res.list.length) break;
      }
    }
    if ((!res.list || !res.list.length) && (pg === "1" || pg === 1)) {
      res = { list: ranking(), pages: 1 };
    }
    return JSON.stringify({
      list: res.list || [],
      page: pg,
      pagecount: Math.max(res.pages || 1, 1),
      limit: 20,
      total: (res.list || []).length
    });
  } catch (e) {
    return JSON.stringify({ list: [], page: "1", pagecount: 1 });
  }
}

function detail(ids) {
  try {
    let vid = "";
    if (Array.isArray(ids)) vid = String(ids[0] || "");
    else if (typeof ids === "object" && ids) vid = String(ids.id || ids.vod_id || "");
    else vid = String(ids || "");
    vid = vid.replace(/^["']|["']$/g, "").trim();
    const bvid = vid.split("?")[0].split("$")[0].trim();
    if (!bvid) return JSON.stringify({ list: [] });
    const info = view(bvid, 1);
    const pages = info.pages || [];
    let play = "";
    if (pages.length <= 1) {
      play = "正片$" + bvid;
    } else {
      const eps = [];
      for (let i = 0; i < pages.length; i++) {
        const name = (pages[i].part || "").trim() || "第" + (i + 1) + "集";
        eps.push(name + "$" + bvid + "?p=" + (i + 1));
      }
      play = eps.join("#");
    }
    const stat = info.stat || {};
    let remark = "";
    if (stat.view != null) {
      const v = parseInt(stat.view, 10) || 0;
      const d = parseInt(stat.danmaku, 10) || 0;
      const fv = v >= 100000000 ? (v / 100000000).toFixed(1) + "亿" : v >= 10000 ? (v / 10000).toFixed(1) + "万" : String(v);
      const fd = d >= 10000 ? (d / 10000).toFixed(1) + "万" : String(d);
      remark = "播放:" + fv + " 弹幕:" + fd;
    }
    let year = "";
    try {
      if (info.pubdate) year = String(new Date(info.pubdate * 1000).getFullYear());
    } catch (e) {}
    const vod = {
      vod_id: bvid,
      vod_name: info.title || bvid,
      vod_pic: pic(info.pic || ""),
      type_name: "音乐/演唱会",
      vod_year: year,
      vod_area: "哔哩哔哩",
      vod_remarks: remark,
      vod_actor: (info.owner && info.owner.name) || "",
      vod_director: "",
      vod_content: info.desc || "",
      vod_play_from: "哔哩哔哩",
      vod_play_url: play
    };
    return JSON.stringify({ list: [vod] });
  } catch (e) {
    return JSON.stringify({ list: [] });
  }
}

function search(key, quick, pg) {
  try {
    pg = String(pg || "1");
    const res = biliSearch(String(key || "").trim(), pg, "totalrank", "0");
    return JSON.stringify({
      list: res.list || [],
      page: pg,
      pagecount: Math.max(res.pages || 1, 1)
    });
  } catch (e) {
    return JSON.stringify({ list: [], page: "1", pagecount: 1 });
  }
}

function play(flag, id, vipFlags) {
  const header = {
    "User-Agent": UA,
    Referer: "https://www.bilibili.com",
    Origin: "https://www.bilibili.com",
    Accept: "*/*",
    "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8"
  };
  if (SESSDATA) header.Cookie = "SESSDATA=" + SESSDATA;

  let bvid = "";
  let p = 1;
  const cand = String(id || "");
  const m = cand.match(/(BV[0-9A-Za-z]{8,})/);
  if (m) {
    bvid = m[1];
    const mp = cand.match(/[?&]p=(\d+)/);
    if (mp) p = parseInt(mp[1], 10);
  }
  if (!bvid) return JSON.stringify({ parse: 0, url: "", header: header });

  try {
    const info = view(bvid, p);
    let cid = info.cid || 0;
    const pages = info.pages || [];
    if (!cid && pages.length) {
      const idx = Math.min(Math.max(p - 1, 0), pages.length - 1);
      cid = pages[idx].cid || 0;
    }
    if (cid) {
      const pu = playurl(bvid, cid);
      if (pu.url) {
        return JSON.stringify({
          parse: 0,
          url: pu.url,
          header: header,
          format: "mp4"
        });
      }
    }
  } catch (e) {}
  return JSON.stringify({ parse: 0, url: "", header: header });
}

// 兼容部分环境命名
function homeContent(filter) {
  return home(filter);
}
function homeVideoContent() {
  return homeVod();
}
function categoryContent(tid, pg, filter, extend) {
  return category(tid, pg, filter, extend);
}
function detailContent(ids) {
  return detail(ids);
}
function searchContent(key, quick, pg) {
  return search(key, quick, pg);
}
function playerContent(flag, id, vipFlags) {
  return play(flag, id, vipFlags);
}

export function __jsEvalReturn() {
  return {
    init: init,
    home: home,
    homeVod: homeVod,
    category: category,
    detail: detail,
    play: play,
    search: search,
    homeContent: homeContent,
    homeVideoContent: homeVideoContent,
    categoryContent: categoryContent,
    detailContent: detailContent,
    searchContent: searchContent,
    playerContent: playerContent
  };
}
