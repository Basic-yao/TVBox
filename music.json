function headers() {
  var h = {
    "User-Agent": UA,
    Referer: "https://www.bilibili.com/",
    Origin: "https://www.bilibili.com",
    Accept: "application/json, text/plain, */*",
    "Accept-Language": "zh-CN,zh;q=0.9"
  };
  var ck = BUVID;
  if (SESSDATA) ck += "; SESSDATA=" + SESSDATA;
  h.Cookie = ck;
  return h;
}

/* ---------- 网络层：TVBox / catvod 环境 ---------- */
function buildUrl(url, params) {
  var full = url;
  if (params) {
    var ks = [];
    for (var k in params) { if (Object.prototype.hasOwnProperty.call(params, k)) ks.push(k); }
    var qs = [];
    for (var i = 0; i < ks.length; i++) {
      qs.push(encodeURIComponent(ks[i]) + "=" + encodeURIComponent(params[ks[i]]));
    }
    if (qs.length) full += (url.indexOf("?") >= 0 ? "&" : "?") + qs.join("&");
  }
  return full;
}

function readText(resp) {
  if (!resp) return "";
  if (typeof resp === "string") return resp;
  try {
    if (typeof resp.text === "function") {
      var t = resp.text();
      if (t && typeof t.then === "function") return t;
      return t;
    }
  } catch (e) {}
  if (typeof resp.content === "string") return resp.content;
  if (typeof resp.body === "string") return resp.body;
  return "";
}

// 统一取文本：优先 req（FongMi/OK 同步），否则用 catvod 的 fetch（异步）
function httpText(url, params) {
  var full = buildUrl(url, params);
  if (typeof req === "function") {
    try {
      var r0 = req(full, { headers: headers() });
      if (r0 && r0.content) return r0.content;
      if (typeof r0 === "string") return r0;
    } catch (e) {}
  }
  if (typeof fetch === "function") {
    var p = fetch(full, { headers: headers(), method: "GET" });
    if (p && typeof p.then === "function") {
      return p.then(function (resp) { return readText(resp); });
    }
    return readText(p);
  }
  return "";
}

function parseJson(txt) {
  if (!txt) return null;
  if (typeof txt === "object") return txt;
  try { return JSON.parse(String(txt)); } catch (e) { return null; }
}

async function httpJson(url, params) {
  try {
    var txt = await httpText(url, params);
    return parseJson(txt);
  } catch (e) {
    return null;
  }
}

/* ---------- WBI 签名 ---------- */
async function getWbiKeys() {
  if (_wbiKeys) return _wbiKeys;
  try {
    var r = await httpJson("https://api.bilibili.com/x/web-interface/nav", null);
    var wbi = (r && r.data && r.data.wbi_img) || {};
    var img = String(wbi.img_url || "").split("/").pop().split(".")[0];
    var sub = String(wbi.sub_url || "").split("/").pop().split(".")[0];
    var raw = img + sub;
    var mixin = "";
    for (var i = 0; i < MIXIN_KEY_ENC_TAB.length; i++) mixin += raw[MIXIN_KEY_ENC_TAB[i]] || "";
    _wbiKeys = mixin.slice(0, 32);
  } catch (e) {
    _wbiKeys = "";
  }
  return _wbiKeys;
}

function md5(str) {
