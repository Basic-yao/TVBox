let _wbiKeys = null;

function headers() {
  const h = {
    "User-Agent": UA,
    Referer: "https://www.bilibili.com/",
    Origin: "https://www.bilibili.com",
    Accept: "application/json, text/plain, */*",
    "Accept-Language": "zh-CN,zh;q=0.9"
  };
  let ck = BUVID;
  if (SESSDATA) ck += "; SESSDATA=" + SESSDATA;
  h.Cookie = ck;
  return h;
}

function httpJson(url, params) {
  try {
    let full = url;
    if (params) {
      const qs = Object.keys(params)
        .map((k) => encodeURIComponent(k) + "=" + encodeURIComponent(params[k]))
        .join("&");
      full += (url.indexOf("?") >= 0 ? "&" : "?") + qs;
    }
    // FongMi / 多数环境注入 req；没有则尝试 fetch
    if (typeof req === "function") {
      const res = req(full, { headers: headers(), timeout: 12000 });
      if (res && res.content) {
        return typeof res.content === "string" ? JSON.parse(res.content) : res.content;
      }
      if (typeof res === "string") return JSON.parse(res);
    }
    if (typeof fetch === "function") {
      // 同步环境可能不支持 await，仅作兜底
    }
  } catch (e) {}
  return null;
}

function getWbiKeys() {
  if (_wbiKeys) return _wbiKeys;
  try {
    const r = httpJson("https://api.bilibili.com/x/web-interface/nav");
    const img = (r.data.wbi_img.img_url || "").split("/").pop().split(".")[0];
    const sub = (r.data.wbi_img.sub_url || "").split("/").pop().split(".")[0];
    const raw = img + sub;
    let mixin = "";
    for (let i = 0; i < MIXIN_KEY_ENC_TAB.length; i++) mixin += raw[MIXIN_KEY_ENC_TAB[i]] || "";
    _wbiKeys = mixin.slice(0, 32);
  } catch (e) {
    _wbiKeys = "";
  }
  return _wbiKeys;
}

function md5(str) {
  // 简易 md5（QuickJS 常见环境无 crypto，内嵌精简实现）
  function cmn(q, a, b, x, s, t) {
    a = (a + q + x + t) | 0;
    return (((a << s) | (a >>> (32 - s))) + b) | 0;
  }
  function ff(a, b, c, d, x, s, t) {
    return cmn((b & c) | (~b & d), a, b, x, s, t);
  }
  function gg(a, b, c, d, x, s, t) {
    return cmn((b & d) | (c & ~d), a, b, x, s, t);
